# Copy to .env and adjust. Never commit .env.
OPSPILOT_ENVIRONMENT=local
OPSPILOT_DEBUG=true

# Datastores. These defaults assume the services are reachable on localhost
# (docker compose up). Docker Compose overrides them with service hostnames.
OPSPILOT_DATABASE_URL=postgresql+asyncpg://opspilot:opspilot@localhost:5432/opspilot
OPSPILOT_REDIS_URL=redis://localhost:6379/0
OPSPILOT_QDRANT_URL=http://localhost:6333

# Logging. log_json defaults to false locally and true everywhere else.
OPSPILOT_LOG_LEVEL=INFO
# OPSPILOT_LOG_JSON=true
